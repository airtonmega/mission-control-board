# ── TeseAI Live Backend — Variáveis de Ambiente ────────────────────────────────
# Copie este arquivo para .env e preencha os valores

# Modo mock — true = sem OpenAI API, respostas simuladas
USE_MOCK_AI=true

# OpenAI API key (obrigatória somente quando USE_MOCK_AI=false)
OPENAI_API_KEY=

# Modelo OpenAI (gpt-4o-mini é suficiente para testes)
OPENAI_MODEL=gpt-4o-mini

# Segredo JWT — altere em produção
JWT_SECRET=change-me-in-production-use-at-least-32-chars

# Debug
DEBUG=false
