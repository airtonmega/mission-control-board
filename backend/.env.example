# ── TeseAI Live Backend — Variáveis de Ambiente ────────────────────────────────
# Copie este arquivo para .env e preencha os valores reais

# OpenAI API key — obrigatória para funcionamento do produto
# Obtenha em: https://platform.openai.com/api-keys
# NUNCA commite este valor. Mantenha apenas em .env (ignorado pelo .gitignore).
OPENAI_API_KEY=sk-...

# Modelo OpenAI — gpt-4o oferece máxima qualidade; gpt-4o-mini é mais econômico
OPENAI_MODEL=gpt-4o-mini

# Timeout em segundos para chamadas à OpenAI
OPENAI_TIMEOUT_SECONDS=60.0

# Número máximo de tentativas de reparo de resposta inválida (recomendado: 1)
OPENAI_MAX_REPAIR_ATTEMPTS=1

# Segredo JWT — use valor aleatório com 32+ chars em produção
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-use-at-least-32-chars

# Debug — false em produção
DEBUG=false
