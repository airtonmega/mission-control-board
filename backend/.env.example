# ── TeseAI Live Backend — Variáveis de Ambiente ────────────────────────────────
# Copie este arquivo para .env e preencha os valores

# Modo mock — true = sem OpenAI API, respostas simuladas (padrão seguro)
USE_MOCK_AI=true

# OpenAI API key (obrigatória somente quando USE_MOCK_AI=false)
# Nunca commite este valor. Mantenha em .env (ignorado pelo .gitignore).
OPENAI_API_KEY=

# Modelo OpenAI — gpt-4o-mini oferece boa relação custo/qualidade para este caso
OPENAI_MODEL=gpt-4o-mini

# Timeout em segundos para chamadas à OpenAI
OPENAI_TIMEOUT_SECONDS=60.0

# Número máximo de tentativas de reparo de resposta inválida (0 = sem reparo)
OPENAI_MAX_REPAIR_ATTEMPTS=1

# Segredo JWT — altere em produção com valor aleatório de 32+ chars
JWT_SECRET=change-me-in-production-use-at-least-32-chars

# Debug
DEBUG=false
